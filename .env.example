APP_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
# Required: choose your own local database password. Never commit .env.
DB_PASSWORD=
# Alternatively set DB_PASSWORD_FILE to a mounted UTF-8 file.
DB_PASSWORD_FILE=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
SESSION_HOURS=8
RESET_MODE=disabled
# Set both explicitly for development demo data; never in production.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
DEMO_USER_EMAIL=assia.benkacem@example.org
DEMO_ADMIN_EMAIL=youssef.amrani@example.org
